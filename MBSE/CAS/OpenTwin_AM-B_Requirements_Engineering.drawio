        </mxCell>
        <mxCell id="p1-53" value="The controller shall detect defined faults, execute the&lt;br&gt;mode-specific response within the hazard-derived time&lt;br&gt;limit, and require explicit acknowledgement before&lt;br&gt;re-arming." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
