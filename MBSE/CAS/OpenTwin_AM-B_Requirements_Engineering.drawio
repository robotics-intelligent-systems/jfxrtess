        <mxCell id="p1-47" value="AM-06 | Energy and water isolation" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#975C15;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
