        </mxCell>
        <mxCell id="p1-53" value="The controller shall detect defined faults, execute the&#10;mode-specific response within the hazard-derived time&#10;limit, and require explicit acknowledgement before&#10;re-arming." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
