        </mxCell>
        <mxCell id="p1-34" value="The two marine propulsors shall operate within a&#10;validated immersion envelope. Invalid immersion shall&#10;inhibit or limit thrust according to the fault policy." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
