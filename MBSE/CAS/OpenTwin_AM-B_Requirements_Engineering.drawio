        <mxCell id="p1-57" value="AM-08 | Real-time supervision" style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#975C15;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
          <mxGeometry x="511" y="926" width="348" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1-58" value="The supervisor shall meet its allocated timing budget&#10;under representative I/O load. P0 proposes a 20 ms&#10;period and deadline; motor inner loops need separate&#10;budgets." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
