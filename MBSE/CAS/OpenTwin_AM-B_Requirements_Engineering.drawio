        </mxCell>
        <mxCell id="p1-48" value="The energy system shall monitor cell, electrical and&#10;water-ingress limits; segregate battery electronics from&#10;wet volumes; and inhibit propulsion while charging or&#10;servicing." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
