        </mxCell>
        <mxCell id="p1-43" value="A deterministic supervisor shall authorize LAND,&#10;TRANSITION and WATER outputs using operator&#10;intent and validated sensor guards. Ambiguous inputs&#10;shall not enable uncontrolled thrust." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
