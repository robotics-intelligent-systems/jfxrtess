        <mxCell id="p1-34" value="The two marine propulsors shall operate within a&lt;br&gt;validated immersion envelope. Invalid immersion shall&lt;br&gt;inhibit or limit thrust according to the fault policy." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
