        <mxCell id="p1-47" value="AM-06 | Energy and water isolation" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#975C15;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
          <mxGeometry x="511" y="558" width="348" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1-48" value="The energy system shall monitor cell, electrical and&lt;br&gt;water-ingress limits; segregate battery electronics from&lt;br&gt;wet volumes; and inhibit propulsion while charging or&lt;br&gt;servicing." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
