        <mxCell id="p4-201" value="At equilibrium: water density × displaced volume = total mass. The loaded waterline, freeboard, CG, heel/trim&#10;and relevant flooded conditions must all be evaluated. Positive buoyancy alone does not establish safe&#10;operation." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#20364B;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
