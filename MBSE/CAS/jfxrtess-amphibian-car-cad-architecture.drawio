        <mxCell id="family-03-footer" value="JFXRTESS | 2026-10-10 | Proposed requirements; no tests executed | 03 - Variant Allocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=16;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1335" width="1700" height="35" />
        </mxCell>
        <mxCell id="S-01" value="S-01 | Roadster packaging&lt;br&gt;&lt;br&gt;The AM-S baseline shall define occupant/restraint space and enclosure/hull packaging from a dimensioned design.&lt;br&gt;Verify: CAD inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="220" width="840" height="225" />
        </mxCell>
        <mxCell id="S-02" value="S-02 | Roadster drivetrain allocation&lt;br&gt;&lt;br&gt;AM-S shall document separate land/marine drive allocation and transition clearances for its selected configuration.&lt;br&gt;Verify: Analysis + MIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="220" width="840" height="225" />
        </mxCell>
        <mxCell id="U6-01" value="U6-01 | Utility load cases&lt;br&gt;&lt;br&gt;AM-U6 shall define secured cargo and occupant load cases and their effect on mass, CG and waterline.&lt;br&gt;Verify: CAD + hydrostatic analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="465" width="840" height="225" />
        </mxCell>
        <mxCell id="U6-02" value="U6-02 | Utility running gear&lt;br&gt;&lt;br&gt;AM-U6 shall define six-wheel steering, braking, traction and load-sharing for the selected running-gear proposal.&lt;br&gt;Verify: Analysis + MIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="465" width="840" height="225" />
        </mxCell>
        <mxCell id="B-01" value="B-01 | Motorcycle balance&lt;br&gt;&lt;br&gt;AM-B shall define rider posture, low-speed land balance and rider/vehicle stability through land-water transition.&lt;br&gt;Verify: Analysis + controlled test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="710" width="840" height="225" />
        </mxCell>
        <mxCell id="B-02" value="B-02 | Motorcycle wet boundaries&lt;br&gt;&lt;br&gt;AM-B shall define rider exposure, immersion-sensitive components and service access for the selected hull/propulsor design.&lt;br&gt;Verify: Inspection + ingress/immersion test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="710" width="840" height="225" />
        </mxCell>
        <mxCell id="amb-link" value="AM-B identifier preservation&lt;br&gt;RT-01: AM-01/13 | RT-02: AM-02 | RT-03: AM-03 | RT-04: AM-04 | RT-05: AM-05 | RT-06: AM-06&lt;br&gt;RT-07: AM-07/08 | RT-08: AM-09/12 | RT-09: AM-10 | RT-10: AM-11/14 | RT-11: AM-15 | RT-12: AM-13/14/16&lt;br&gt;Original AM-B P01-P18 and V01-V16 remain in its editable requirements file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=23;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1000" width="1700" height="230" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="family-04" name="04 - Control and Model Interfaces">
    <mxGraphModel dx="1800" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="family-04-title" value="OpenTwin family | Local control and engineering interfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10243A;strokeColor=#A8BBCC;fontColor=#FFFFFF;fontSize=30;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="35" width="1700" height="60" />
        </mxCell>
        <mxCell id="family-04-sub" value="Solid = local intent/control or approved build artifacts. Dashed = noncritical telemetry and analytical evidence. No remote actuator authority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
