        </mxCell>
        <mxCell id="family-04-footer" value="JFXRTESS | 2026-10-10 | Proposed requirements; no tests executed | 04 - Control and Model Interfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=16;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1285" width="1700" height="35" />
        </mxCell>
        <mxCell id="operator" value="I-01 | Operator intent&lt;br&gt;Mode request, brake, acknowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=22;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
