        <mxCell id="family-03-title" value="OpenTwin family | Variant allocation and AM-B crosswalk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10243A;strokeColor=#A8BBCC;fontColor=#FFFFFF;fontSize=30;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="35" width="1700" height="60" />
        </mxCell>
        <mxCell id="family-03-sub" value="Common requirements apply to all three concepts; variant requirements refine distinct physical questions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="115" width="1700" height="75" />
