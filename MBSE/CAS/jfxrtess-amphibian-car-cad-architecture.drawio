        <mxCell id="family-01-title" value="OpenTwin AM-S / AM-U6 | Concept scope and evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10243A;strokeColor=#A8BBCC;fontColor=#FFFFFF;fontSize=30;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="35" width="1700" height="60" />
        </mxCell>
        <mxCell id="family-01-sub" value="Three CAD-directory concept images. Visual intent is not dimensional geometry, implemented software or verified performance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="115" width="1700" height="75" />
        </mxCell>
        <mxCell id="family-01-footer" value="JFXRTESS | 2026-10-10 | Proposed requirements; no tests executed | 01 - CAD Context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=16;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1285" width="1700" height="35" />
        </mxCell>
        <mxCell id="c0" value="AM-S&lt;br&gt;Roadster concept&lt;br&gt;Land and water operation, occupant packaging and separate propulsion allocation.&lt;br&gt;&lt;br&gt;SOURCE&lt;br&gt;amphibious-sport-roadster.jpg&lt;br&gt;Git blob: bacdc5130772ae916d46ab5625f61b2b49701873" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1" link="../CAD/amphibious-sport-roadster.jpg">
          <mxGeometry as="geometry" x="50" y="220" width="550" height="380" />
        </mxCell>
        <mxCell id="need0" value="REQUIREMENTS TO DERIVE&lt;br&gt;Occupancy, dimensions, mass/CG, hull, drive clearances and operator-controlled mode policy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="640" width="550" height="260" />
        </mxCell>
        <mxCell id="c1" value="AM-U6&lt;br&gt;Utility concept&lt;br&gt;Six-wheel proposal, secured cargo, load-dependent CG and waterline.&lt;br&gt;&lt;br&gt;SOURCE&lt;br&gt;deeper-vehicle-immersion-in water-mode.jpg&lt;br&gt;Git blob: f0585fc25a9e59fd6bb3803453cdba7cd0afa8c9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1" link="../CAD/deeper-vehicle-immersion-in water-mode.jpg">
          <mxGeometry as="geometry" x="620" y="220" width="550" height="380" />
        </mxCell>
        <mxCell id="need1" value="REQUIREMENTS TO DERIVE&lt;br&gt;Payload/restraints, axle/steering allocation, load cases, flooded stability and service access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="640" width="550" height="260" />
        </mxCell>
        <mxCell id="c2" value="AM-B&lt;br&gt;Motorcycle concept&lt;br&gt;Single-rider proposal, balance and wet boundaries; detailed AM-01..16 baseline retained.&lt;br&gt;&lt;br&gt;SOURCE&lt;br&gt;amphibious-motorcycle-concept.jpg&lt;br&gt;Git blob: 76f4d432fb1597ee936cccc1c2860456522b484b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1" link="../CAD/amphibious-motorcycle-concept.jpg">
          <mxGeometry as="geometry" x="1190" y="220" width="550" height="380" />
        </mxCell>
        <mxCell id="need2" value="REQUIREMENTS TO DERIVE&lt;br&gt;Rider load/posture, mode guards, immersion and fault policy; electric architecture remains a proposal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=21;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="640" width="550" height="260" />
        </mxCell>
        <mxCell id="limits" value="SOURCE LIMIT&lt;br&gt;No dimensioned CAD, measured prototype, hydrofoil/retraction mechanism, autonomy requirement or certified ingress rating exists in this source baseline. Resolve D01-D12; do not scale geometry or performance from pixels." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=23;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
