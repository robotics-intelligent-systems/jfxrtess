        </mxCell>
        <mxCell id="sensor" value="I-02 | Sensor guards&lt;br&gt;Age, validity, SI units, frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=22;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="620" width="420" height="170" />
        </mxCell>
        <mxCell id="local" value="Local supervisor&lt;br&gt;Mode + interlock + fault policy&lt;br&gt;Selected MCU / RTOS&lt;br&gt;RT-05..08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=22;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="250" width="480" height="240" />
        </mxCell>
        <mxCell id="drive" value="I-03 | Drive adapters&lt;br&gt;Land / marine allocation&lt;br&gt;Local energy isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=22;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1330" y="250" width="420" height="200" />
        </mxCell>
        <mxCell id="model" value="I-04 | Plant/model runner&lt;br&gt;Approved CAD/load baseline&lt;br&gt;FMI profile and state ownership&lt;br&gt;OpenModelica / optional Gazebo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=22;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="620" width="480" height="210" />
