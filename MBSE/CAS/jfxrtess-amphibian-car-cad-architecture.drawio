  <diagram id="family-02" name="02 - Shared Requirements">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="family-02-title" value="OpenTwin family | Shared high-level requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10243A;strokeColor=#A8BBCC;fontColor=#FFFFFF;fontSize=30;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="35" width="1700" height="60" />
        </mxCell>
        <mxCell id="family-02-sub" value="RT-01..RT-12 are proposed system requirements. Approval needs a parameter baseline and acceptance evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="115" width="1700" height="75" />
        </mxCell>
        <mxCell id="family-02-footer" value="JFXRTESS | 2026-10-10 | Proposed requirements; no tests executed | 02 - Shared Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=16;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1335" width="1700" height="35" />
        </mxCell>
        <mxCell id="RT-01" value="RT-01 | Configuration baseline&lt;br&gt;&lt;br&gt;The project shall identify concept variant, source hash, geometry, mass and CG baseline for each accepted load case.&lt;br&gt;&lt;br&gt;Owner: CAD / configuration&lt;br&gt;Verify: Inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="220" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-02" value="RT-02 | Land mobility&lt;br&gt;&lt;br&gt;Each variant shall demonstrate operator-controlled steering, traction and braking within its approved land envelope.&lt;br&gt;&lt;br&gt;Owner: Vehicle dynamics&lt;br&gt;Verify: Analysis + controlled test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="220" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-03" value="RT-03 | Buoyancy and stability&lt;br&gt;&lt;br&gt;Each hull shall meet approved loaded freeboard, stability and defined flooded-condition criteria.&lt;br&gt;&lt;br&gt;Owner: Naval / mechanical&lt;br&gt;Verify: Hydrostatic analysis + supervised test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="220" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-04" value="RT-04 | Marine propulsion&lt;br&gt;&lt;br&gt;Marine propulsion shall be enabled only within its validated immersion and actuator-availability envelope.&lt;br&gt;&lt;br&gt;Owner: Marine / controls&lt;br&gt;Verify: MIL + bench + supervised test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="485" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-05" value="RT-05 | Mode transitions&lt;br&gt;&lt;br&gt;A local supervisor shall authorize LAND, TRANSITION and WATER using operator intent and validated guards.&lt;br&gt;&lt;br&gt;Owner: Controls&lt;br&gt;Verify: MIL / SIL / controller-HIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="485" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-06" value="RT-06 | Energy and ingress&lt;br&gt;&lt;br&gt;The design shall define energy isolation, thermal limits, ingress monitoring and charge/service propulsion interlocks.&lt;br&gt;&lt;br&gt;Owner: Electrical&lt;br&gt;Verify: Inspection + bench fault injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="485" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-07" value="RT-07 | Fault and timing policy&lt;br&gt;&lt;br&gt;The supervisor shall meet allocated execution deadlines and mode-specific hazard-derived fault-response times.&lt;br&gt;&lt;br&gt;Owner: Embedded / safety&lt;br&gt;Verify: SIL / target controller-HIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="750" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-08" value="RT-08 | Local authority&lt;br&gt;&lt;br&gt;Essential control and fault handling shall remain local during loss of engineering, cloud or telemetry connections.&lt;br&gt;&lt;br&gt;Owner: Embedded / integration&lt;br&gt;Verify: Disconnect and permission test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="750" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-09" value="RT-09 | Coupled-model contract&lt;br&gt;&lt;br&gt;Land and water models shall share configuration, SI units, frames and a declared clock/solver owner for each coupled state.&lt;br&gt;&lt;br&gt;Owner: Simulation&lt;br&gt;Verify: Interface test + model comparison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="750" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-10" value="RT-10 | Telemetry and evidence&lt;br&gt;&lt;br&gt;Test records shall preserve timestamps, validity, source versions, configuration and requirement/test references.&lt;br&gt;&lt;br&gt;Owner: Data / verification&lt;br&gt;Verify: Schema + replay + audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1015" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-11" value="RT-11 | Maintainability&lt;br&gt;&lt;br&gt;Each variant shall define service isolation, hull/drivetrain access, drainage and post-service integrity checks.&lt;br&gt;&lt;br&gt;Owner: Service / mechanical&lt;br&gt;Verify: Inspection + demonstration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1015" width="550" height="245" />
        </mxCell>
        <mxCell id="RT-12" value="RT-12 | Stage release&lt;br&gt;&lt;br&gt;Each stage shall close critical design decisions and approve operating envelope, configuration and verification dispositions.&lt;br&gt;&lt;br&gt;Owner: Systems engineering&lt;br&gt;Verify: Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A8BBCC;fontColor=#10243A;fontSize=19;align=left;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="1015" width="550" height="245" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="family-03" name="03 - Variant Allocation">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0" background="#FFFFFF">
      <root>
