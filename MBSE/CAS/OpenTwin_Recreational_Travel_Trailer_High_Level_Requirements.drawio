<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-09T03:12:05.291785+00:00" agent="ChatGPT" version="31.4.2" type="device">
<diagram id="2c9259ecd4e4" name="01 - Scope &amp; CONOPS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="OpenTwin Recreational Travel Trailer — High-Level Requirements Engineering" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b&gt;System Concept&lt;/b&gt;&lt;br&gt;Compact/modular towable recreational travel trailer providing sleeping, living, food-preparation, sanitation, energy and connected OpenTwin functions for short- and medium-duration travel." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="240" as="geometry"/></mxCell><mxCell id="use" value="&lt;b&gt;Primary Use Cases&lt;/b&gt;&lt;br&gt;• Road travel / touring&lt;br&gt;• Campsite accommodation&lt;br&gt;• Rural / nature tourism&lt;br&gt;• Temporary remote work&lt;br&gt;• Off-grid short-duration stay&lt;br&gt;• Mobile digital-twin / IoT demonstrator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="585" y="140" width="430" height="240" as="geometry"/></mxCell><mxCell id="stake" value="&lt;b&gt;Stakeholders&lt;/b&gt;&lt;br&gt;Owner / occupants&lt;br&gt;Tow-vehicle operator&lt;br&gt;Mechanical / structural engineer&lt;br&gt;Electrical / energy engineer&lt;br&gt;HVAC / plumbing engineer&lt;br&gt;OpenTwin / embedded engineer&lt;br&gt;Maintenance staff&lt;br&gt;Regulatory / inspection authorities" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1100" y="140" width="430" height="240" as="geometry"/></mxCell><mxCell id="bound" value="&lt;b&gt;System Boundary&lt;/b&gt;&lt;br&gt;IN: chassis, coupling, body, stabilizers, interior furniture, sleeping/living modules, kitchen, optional sanitation/water, electrical/energy, HVAC/ventilation, safety systems, sensors, gateway and digital twin.&lt;br&gt;&lt;br&gt;OUT: tow-vehicle design and jurisdiction-specific certification engineering." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="470" width="700" height="290" as="geometry"/></mxCell><mxCell id="modes" value="&lt;b&gt;Operating Modes&lt;/b&gt;&lt;br&gt;TRANSPORT / TOW&lt;br&gt;PARKED / SETUP&lt;br&gt;OCCUPIED / CAMPING&lt;br&gt;OFF-GRID&lt;br&gt;SHORE-POWER&lt;br&gt;SLEEP / LOW-POWER&lt;br&gt;MAINTENANCE&lt;br&gt;EMERGENCY / SAFE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="470" width="700" height="290" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Engineering Baseline&lt;/b&gt;&lt;br&gt;The concept shall progress through requirements → MBSE → CAD → simulation → prototype → controlled verification. Mass, axle loading, hitch load, braking, structural integrity, electrical safety, ventilation, gas/fuel systems if fitted, fire safety and roadworthiness require qualified engineering validation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="830" width="1100" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="efcfb45aa674" name="02 - Functional Requirements"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="FR-01" value="&lt;b&gt;FR-01 — Towability&lt;/b&gt;&lt;br&gt;Provide a compatible coupling, safety attachment, road lighting/signaling interface and transport configuration." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-02" value="&lt;b&gt;FR-02 — Stabilization&lt;/b&gt;&lt;br&gt;Provide a defined parked stabilization and leveling capability." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-03" value="&lt;b&gt;FR-03 — Living Space&lt;/b&gt;&lt;br&gt;Provide configurable seating/dining and interior circulation appropriate to the intended occupancy." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-04" value="&lt;b&gt;FR-04 — Sleeping&lt;/b&gt;&lt;br&gt;Provide secure sleeping accommodation for the defined design occupancy." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-05" value="&lt;b&gt;FR-05 — Kitchen&lt;/b&gt;&lt;br&gt;Provide a compact food-preparation/storage area with safe separation of heat, water and electrical services." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-06" value="&lt;b&gt;FR-06 — Water&lt;/b&gt;&lt;br&gt;Where fitted, provide potable-water storage/distribution and physically separated waste-water handling." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-07" value="&lt;b&gt;FR-07 — Sanitation&lt;/b&gt;&lt;br&gt;Where fitted, provide serviceable sanitation facilities with odor, ventilation and waste-control provisions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-08" value="&lt;b&gt;FR-08 — Energy&lt;/b&gt;&lt;br&gt;Provide protected electrical distribution for DC loads and approved AC loads when shore/inverter power is used." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-09" value="&lt;b&gt;FR-09 — Climate&lt;/b&gt;&lt;br&gt;Provide ventilation and, where required, heating/cooling compatible with the target climate and energy budget." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-10" value="&lt;b&gt;FR-10 — Lighting&lt;/b&gt;&lt;br&gt;Provide interior task/ambient lighting and exterior entry/service lighting." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-11" value="&lt;b&gt;FR-11 — OpenTwin&lt;/b&gt;&lt;br&gt;Publish selected energy, temperature, humidity, water, door/window and safety states to a local digital twin." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-12" value="&lt;b&gt;FR-12 — Offline&lt;/b&gt;&lt;br&gt;Essential local trailer functions shall remain operational without cloud or Internet connectivity." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ddff138a82d5" name="03 - NFR &amp; Constraints"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Non-Functional Requirements &amp; Constraints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;NFR-01 Road Safety&lt;/b&gt;&lt;br&gt;Transport configuration shall prevent unintended deployment/opening and maintain required clearance and visibility." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;NFR-02 Mass &amp; Loading&lt;/b&gt;&lt;br&gt;GVWR target, payload, axle loads, tire ratings, hitch/tongue load and center-of-gravity envelope shall be defined and verified." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;NFR-03 Structural&lt;/b&gt;&lt;br&gt;Chassis, body, furniture restraints and attachment points shall withstand defined road, vibration and parked load cases." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;NFR-04 Fire/Life Safety&lt;/b&gt;&lt;br&gt;Provide detection, egress, isolation and suitable fire-response provisions based on installed energy/cooking systems." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;NFR-05 Electrical&lt;/b&gt;&lt;br&gt;Use protected distribution, isolation, grounding/bonding strategy, overcurrent protection and appropriate environmental ratings." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;NFR-06 Indoor Environment&lt;/b&gt;&lt;br&gt;Control ventilation, condensation, temperature and humidity within the intended occupancy/climate envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;NFR-07 Maintainability&lt;/b&gt;&lt;br&gt;Routine service items, tanks, filters, batteries, electronics, seals and appliances shall be accessible." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;NFR-08 Modularity&lt;/b&gt;&lt;br&gt;Energy, HVAC, water, sanitation, communications and furniture modules should use documented interfaces." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;NFR-09 Cybersecurity&lt;/b&gt;&lt;br&gt;Connected functions shall use authentication, protected credentials, least privilege and secure update practices." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;NFR-10 Privacy&lt;/b&gt;&lt;br&gt;Occupancy/telemetry collection shall be minimized and configurable; sensitive personal data is outside the core twin by default." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;NFR-11 Availability&lt;/b&gt;&lt;br&gt;Network or remote-service loss shall not disable lighting, ventilation, safety monitoring or other essential local functions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;NFR-12 Sustainability&lt;/b&gt;&lt;br&gt;Favor efficient appliances, repairable modules, low-power standby, recyclable materials and optional renewable generation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="9bbb6986a2f1" name="04 - Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="OpenTwin Recreational Trailer — High-Level Architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="veh" value="&lt;b&gt;STRUCTURE / ROAD SYSTEMS&lt;/b&gt;&lt;br&gt;Chassis&lt;br&gt;Axle / suspension&lt;br&gt;Wheels / tires&lt;br&gt;Coupling&lt;br&gt;Braking interface&lt;br&gt;Stabilizers&lt;br&gt;Body / openings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="150" width="280" height="280" as="geometry"/></mxCell><mxCell id="hab" value="&lt;b&gt;HABITATION&lt;/b&gt;&lt;br&gt;Sleeping&lt;br&gt;Seating / dining&lt;br&gt;Kitchen&lt;br&gt;Storage&lt;br&gt;Optional sanitation&lt;br&gt;Interior ergonomics" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="390" y="150" width="280" height="280" as="geometry"/></mxCell><mxCell id="util" value="&lt;b&gt;UTILITIES&lt;/b&gt;&lt;br&gt;Electrical power&lt;br&gt;Battery / optional solar&lt;br&gt;Shore power / inverter&lt;br&gt;Water / waste&lt;br&gt;HVAC / ventilation&lt;br&gt;Lighting" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="720" y="150" width="280" height="280" as="geometry"/></mxCell><mxCell id="safe" value="&lt;b&gt;SAFETY &amp; SENSING&lt;/b&gt;&lt;br&gt;Smoke / CO as applicable&lt;br&gt;Temperature / humidity&lt;br&gt;Water levels&lt;br&gt;Door/window state&lt;br&gt;Energy status&lt;br&gt;Fault monitoring" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1050" y="150" width="280" height="280" as="geometry"/></mxCell><mxCell id="edge" value="&lt;b&gt;OPENTWIN EDGE&lt;/b&gt;&lt;br&gt;Local gateway&lt;br&gt;Sensor adapters&lt;br&gt;Rules / alarms&lt;br&gt;Configuration registry&lt;br&gt;Offline event buffer&lt;br&gt;Local API" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1050" y="560" width="280" height="260" as="geometry"/></mxCell><mxCell id="twin" value="&lt;b&gt;TRAILER DIGITAL TWIN&lt;/b&gt;&lt;br&gt;Asset Twin&lt;br&gt;Energy Twin&lt;br&gt;Habitation Twin&lt;br&gt;Water Twin&lt;br&gt;Climate Twin&lt;br&gt;Maintenance Twin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="720" y="560" width="280" height="260" as="geometry"/></mxCell><mxCell id="sim" value="&lt;b&gt;jfxrtess ENGINEERING&lt;/b&gt;&lt;br&gt;MBSE&lt;br&gt;Plant models&lt;br&gt;MIL / SIL&lt;br&gt;HIL / CHIL&lt;br&gt;RCP / embedded control&lt;br&gt;Verification evidence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="390" y="560" width="280" height="260" as="geometry"/></mxCell><mxCell id="hmi" value="&lt;b&gt;OCCUPANT / SERVICE HMI&lt;/b&gt;&lt;br&gt;Energy&lt;br&gt;Climate&lt;br&gt;Water&lt;br&gt;Lighting&lt;br&gt;Safety alerts&lt;br&gt;Maintenance&lt;br&gt;Setup checklist" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="560" width="280" height="260" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="veh" target="hab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="hab" target="util"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="util" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="safe" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="edge" target="twin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sim" target="twin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="twin" target="hmi"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a9588dde578e" name="05 - Utilities &amp; Safety"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Energy, Water, Climate &amp; Safety Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="ENE" value="&lt;b&gt;Energy System&lt;/b&gt;&lt;br&gt;Protected low-voltage DC bus; battery monitoring; optional solar/MPPT; shore-power interface where fitted; inverter only for approved loads; load shedding; local manual isolation; OpenTwin energy telemetry." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="130" width="690" height="190" as="geometry"/></mxCell><mxCell id="WAT" value="&lt;b&gt;Water / Waste&lt;/b&gt;&lt;br&gt;Potable and waste systems separated; level sensing optional; freeze/heat considerations by climate; drain/service access; leak detection recommended; sanitation module optional." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="130" width="690" height="190" as="geometry"/></mxCell><mxCell id="HVAC" value="&lt;b&gt;Climate / Ventilation&lt;/b&gt;&lt;br&gt;Natural/mechanical ventilation; condensation control; heating/cooling option sized from thermal analysis; sleep-mode noise/energy considerations; local override." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="365" width="690" height="190" as="geometry"/></mxCell><mxCell id="SAFE" value="&lt;b&gt;Life Safety&lt;/b&gt;&lt;br&gt;Emergency egress; smoke/CO detection as applicable; fire extinguisher provision; electrical isolation; cooking ventilation; trip/fall reduction; safe storage of loose items during towing." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="365" width="690" height="190" as="geometry"/></mxCell><mxCell id="GAS" value="&lt;b&gt;Fuel / Gas Option&lt;/b&gt;&lt;br&gt;If LPG or another combustible fuel is used, storage, ventilation, shutoff, detection, appliance installation and servicing shall be treated as a dedicated safety subsystem. All-electric architecture is preferred where feasible." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="600" width="690" height="190" as="geometry"/></mxCell><mxCell id="IOT" value="&lt;b&gt;OpenTwin / IoT&lt;/b&gt;&lt;br&gt;Local-first controls; no cloud dependency for essential functions; alarms remain local; telemetry export optional; documented interfaces; secure updates; configuration/version history." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="600" width="690" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="9dba1db6ebcc" name="06 - Interfaces &amp; Twin Data"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Interfaces &amp; OpenTwin Data Model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="i0" value="&lt;b&gt;IF-01 Towing&lt;/b&gt;&lt;br&gt;Coupler, safety chains/cables, breakaway/braking where applicable, road lights and tow-vehicle electrical connector." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="130" width="690" height="160" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;IF-02 Structural&lt;/b&gt;&lt;br&gt;Chassis/body, axle, furniture/restraints, stabilizers, doors, windows, roof modules and service penetrations." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="130" width="690" height="160" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;IF-03 Electrical&lt;/b&gt;&lt;br&gt;Battery/DC bus, shore input, solar, inverter, protection, grounding/bonding, appliance and sensor circuits." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="335" width="690" height="160" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;IF-04 Fluid&lt;/b&gt;&lt;br&gt;Potable fill, pump, fixtures, gray/black waste where fitted, vents, drains and service interfaces." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="335" width="690" height="160" as="geometry"/></mxCell><mxCell id="i4" value="&lt;b&gt;IF-05 Data&lt;/b&gt;&lt;br&gt;Local sensor bus/IP network, documented schemas, timestamped events, local buffering and optional remote synchronization." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="540" width="690" height="160" as="geometry"/></mxCell><mxCell id="i5" value="&lt;b&gt;IF-06 Human&lt;/b&gt;&lt;br&gt;Entry/egress, bed/seating conversion, kitchen, controls, service panels, setup/stow procedures and emergency access." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="540" width="690" height="160" as="geometry"/></mxCell><mxCell id="schema" value="&lt;b&gt;Minimum OpenTwin State&lt;/b&gt;&lt;br&gt;asset_id · configuration_id · transport/deployed mode · battery SOC · DC/AC power state · solar state · interior/exterior temperature · humidity · potable/waste levels (if fitted) · door/window state · smoke/CO alarm state (if fitted) · HVAC state · faults · maintenance_due · software_version · timestamp · provenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="300" y="770" width="1000" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="fc5aa0de681d" name="07 - RT Simulation &amp; HIL"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="jfxrtess Verification Architecture — MBSE / MIL / SIL / HIL / CHIL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="160" y="25" width="1280" height="70" as="geometry"/></mxCell><mxCell id="mbse" value="&lt;b&gt;MBSE&lt;/b&gt;&lt;br&gt;Stakeholder needs&lt;br&gt;CONOPS&lt;br&gt;Logical/physical architecture&lt;br&gt;Requirements traceability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="190" width="250" height="220" as="geometry"/></mxCell><mxCell id="mil" value="&lt;b&gt;MIL&lt;/b&gt;&lt;br&gt;Energy model&lt;br&gt;Thermal model&lt;br&gt;Water model&lt;br&gt;Control/rules model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="370" y="190" width="250" height="220" as="geometry"/></mxCell><mxCell id="sil" value="&lt;b&gt;SIL&lt;/b&gt;&lt;br&gt;Gateway software&lt;br&gt;Alarm logic&lt;br&gt;Energy manager&lt;br&gt;OpenTwin adapters" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="670" y="190" width="250" height="220" as="geometry"/></mxCell><mxCell id="hil" value="&lt;b&gt;HIL / CHIL&lt;/b&gt;&lt;br&gt;Real controllers&lt;br&gt;Battery/BMS emulator&lt;br&gt;Sensor I/O&lt;br&gt;Fault injection" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="970" y="190" width="250" height="220" as="geometry"/></mxCell><mxCell id="proto" value="&lt;b&gt;PROTOTYPE&lt;/b&gt;&lt;br&gt;Integrated trailer&lt;br&gt;Road systems&lt;br&gt;Utilities&lt;br&gt;Environmental tests" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1270" y="190" width="250" height="220" as="geometry"/></mxCell><mxCell id="evidence" value="&lt;b&gt;Verification Evidence Repository&lt;/b&gt;&lt;br&gt;Requirement ID → test/analysis → configuration baseline → measured result → acceptance status → reviewer → artifact reference" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="590" width="1000" height="150" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;jfxrtess alignment:&lt;/b&gt; real-time simulation, controller-hardware-in-the-loop, embedded/industrial connectivity and digital-twin technologies are used as engineering infrastructure for the trailer rather than assuming the repository already implements a finished recreational vehicle." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="300" y="800" width="1000" height="130" as="geometry"/></mxCell><mxCell id="a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="mbse" target="mil"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="mil" target="sil"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sil" target="hil"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="hil" target="proto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="proto" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c2485ea8b70e" name="08 - V&amp;V Traceability"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Verification, Validation &amp; Requirements Traceability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="v0" value="&lt;b&gt;V-01 Inspection&lt;/b&gt;&lt;br&gt;Dimensions, labels, guards, transport locks, egress, furniture restraint, serviceability and workmanship." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="690" height="145" as="geometry"/></mxCell><mxCell id="v1" value="&lt;b&gt;V-02 Analysis&lt;/b&gt;&lt;br&gt;Mass/payload, hitch load, axle/tire loads, CG envelope, structural loads, electrical load, thermal and water budgets." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="120" width="690" height="145" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;V-03 Bench Test&lt;/b&gt;&lt;br&gt;Electrical protection, BMS/energy manager, sensors, alarms, lighting, pumps, gateway and offline operation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="305" width="690" height="145" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;V-04 Environmental&lt;/b&gt;&lt;br&gt;Water ingress/spray where applicable, temperature, humidity/condensation, vibration and component environmental suitability." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="305" width="690" height="145" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;V-05 Parked Prototype&lt;/b&gt;&lt;br&gt;Stabilization, leveling, occupancy workflow, bed/furniture conversion, kitchen/water/HVAC and emergency egress." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="490" width="690" height="145" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;V-06 Controlled Towing&lt;/b&gt;&lt;br&gt;Closed/controlled towing tests for coupling, braking interface, lighting, stability and component retention before public-road use." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="490" width="690" height="145" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;V-07 OpenTwin V&amp;V&lt;/b&gt;&lt;br&gt;State accuracy, timestamping, configuration traceability, alarm behavior, connectivity-loss recovery and data integrity." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="675" width="690" height="145" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;V-08 Compliance Review&lt;/b&gt;&lt;br&gt;Map the final configuration to applicable trailer/RV, road, electrical, fire, fuel/gas, sanitation and local camping requirements." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="675" width="690" height="145" as="geometry"/></mxCell><mxCell id="trace" value="&lt;b&gt;Traceability rule:&lt;/b&gt; Stakeholder Need → System Requirement → Subsystem Requirement → Design Element → Verification Method → Evidence → Configuration Baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="870" width="1100" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="79ef999cbd56" name="09 - MVP &amp; Roadmap"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="MVP Baseline &amp; Development Roadmap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="mvp" value="&lt;b&gt;MVP / Recreational Trailer Demonstrator&lt;/b&gt;&lt;br&gt;• Towable single-axle concept&lt;br&gt;• Sleeping for defined prototype occupancy&lt;br&gt;• Convertible seating/table&lt;br&gt;• Compact kitchen/storage&lt;br&gt;• Protected DC electrical system&lt;br&gt;• Optional shore power + solar-ready interface&lt;br&gt;• Interior/exterior lighting&lt;br&gt;• Ventilation&lt;br&gt;• Basic potable/waste-water concept&lt;br&gt;• Smoke/CO provisions as applicable&lt;br&gt;• Temperature/humidity + energy sensing&lt;br&gt;• OpenTwin local gateway/dashboard" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="570" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1 — Requirements / MBSE&lt;/b&gt;&lt;br&gt;CONOPS&lt;br&gt;Occupancy&lt;br&gt;Road envelope&lt;br&gt;Hazards&lt;br&gt;Requirements baseline&lt;br&gt;Regulatory matrix" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="140" width="380" height="220" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2 — CAD / Simulation&lt;/b&gt;&lt;br&gt;Packaging&lt;br&gt;Mass/CG&lt;br&gt;Structure&lt;br&gt;Thermal/energy&lt;br&gt;Water&lt;br&gt;Electrical architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="140" width="380" height="220" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3 — RTES / HIL&lt;/b&gt;&lt;br&gt;Energy manager&lt;br&gt;Sensor gateway&lt;br&gt;Alarm logic&lt;br&gt;MIL/SIL/HIL&lt;br&gt;OpenTwin integration" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="440" width="380" height="220" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Phase 4 — Prototype / V&amp;V&lt;/b&gt;&lt;br&gt;Physical integration&lt;br&gt;Parked tests&lt;br&gt;Environmental tests&lt;br&gt;Controlled towing&lt;br&gt;Traceability closure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="440" width="380" height="220" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Release Gate&lt;/b&gt;&lt;br&gt;Public-road or commercial/recreational occupancy use begins only after the final configuration satisfies applicable structural, towing, braking, electrical, fire/life-safety, ventilation, fuel/gas (if fitted), sanitation and jurisdiction-specific requirements." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="420" y="790" width="1000" height="130" as="geometry"/></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p4" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>